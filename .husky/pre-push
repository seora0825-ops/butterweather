# main으로 직접 push하는 것을 막는다.
#
# **서버가 먼저 막는다.** 저장소가 public 이라 GitHub ruleset `main protection`
# (PR 필수 · force push 금지 · 삭제 금지)이 걸려 있다. 이 훅은 그 앞의 한 겹이다 —
# 서버에서 거절당하기 전에 내 컴퓨터에서 미리 알려준다.
# husky 훅이라 npm install 한 사람 모두에게 적용된다.
#
# ⚠️ 저장소를 private 으로 돌리면 무료 플랜에서는 ruleset 이 사라진다
# (rulesets API가 "Upgrade to GitHub Pro or make this repository public"을 준다).
# 그때는 이 훅이 유일한 방어선이 된다.

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo ""
      echo "  ✋ main으로 직접 push할 수 없습니다."
      echo ""
      echo "     브랜치 → PR → 머지 순서로 가주세요."
      echo "       git switch -c feature/작업내용"
      echo "       ./pr.sh <type> \"<제목>\" \"<작업 내용>\" --scope <SCOPE>"
      echo ""
      echo "     --no-verify로 이 훅을 넘겨도 GitHub ruleset이 다시 막습니다."
      echo ""
      exit 1
      ;;
  esac
done

exit 0
